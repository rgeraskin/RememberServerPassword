<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9</LangVersion>
    <AssemblyName>MagiCorp.RememberServerPassword</AssemblyName>
    <RootNamespace>MagiCorp.RememberServerPassword</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.1.0</Version>
    <PortReference Condition="'$(PortReference)' == ''">/opt/valheim-port/reference-1.0.12</PortReference>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="$(PortReference)/Managed/*.dll" Exclude="$(PortReference)/Managed/assembly_*.dll;$(PortReference)/Managed/mscorlib.dll;$(PortReference)/Managed/System*.dll;$(PortReference)/Managed/netstandard.dll"><Private>false</Private></Reference>
    <Reference Include="$(PortReference)/Managed/netstandard.dll"><Private>false</Private></Reference>
    <Reference Include="$(PortReference)/publicized/*.dll"><Private>false</Private></Reference>
    <Reference Include="$(PortReference)/BepInEx/core/BepInEx.dll"><Private>false</Private></Reference>
    <Reference Include="$(PortReference)/BepInEx/core/0Harmony.dll"><Private>false</Private></Reference>
    <Reference Include="System.Security" />
  </ItemGroup>
</Project>
